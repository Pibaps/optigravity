/* Optigravity Phase 2 TUI Stylesheet */

Screen {
    background: #0e1116;
    color: #e6edf3;
}

Header {
    background: #131720;
    color: #c9d1d9;
    height: 1;
    dock: top;
}

Footer {
    background: #131720;
    color: #8b949e;
}

#session-bar {
    height: 2;
    background: #121620;
    color: #d0d7de;
    padding: 0 2;
    border-bottom: solid #262e3d;
}

#proposal-bar {
    height: auto;
    background: #231d12;
    border-bottom: solid #523d14;
    padding: 0 2;
    display: none;
    align: left middle;
}

#proposal-bar.visible {
    display: block;
}

#proposal-text {
    width: 1fr;
    color: #f0c674;
    padding: 0 1 0 0;
}

#proposal-apply-btn {
    height: 1;
    min-width: 12;
    border: none;
    background: #3b2e13;
    color: #f0c674;
}

#main-body {
    height: 1fr;
}

#transcript-pane {
    width: 1fr;
    height: 1fr;
}

#session-switcher {
    width: 1fr;
    height: 1fr;
}

SessionTranscript {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: #0e1116;
    scrollbar-size: 1 1;
    scrollbar-color: #2a3344;
    scrollbar-color-hover: #485263;
    scrollbar-background: #0e1116;
}

#new-messages-pill {
    display: none;
    dock: bottom;
    height: 1;
    width: auto;
    margin: 0 2 1 2;
    padding: 0 2;
    background: #1f3558;
    color: #e6edf3;
    text-style: bold;
    border: none;
}

#new-messages-pill.visible {
    display: block;
}

/* Assistant messages & Markdown */
AssistantMessage {
    height: auto;
    margin: 0 0 1 0;
}

AssistantMessage Markdown {
    margin: 0;
    padding: 0 1;
    background: transparent;
}

AssistantMessage .msg-toolbar {
    height: 1;
    align: right middle;
    padding: 0 1;
}

AssistantMessage .copy-md-btn {
    height: 1;
    min-width: 8;
    border: none;
    background: #18202c;
    color: #8b949e;
    padding: 0 1;
}

AssistantMessage .copy-md-btn:hover {
    background: #263245;
    color: #e6edf3;
}

.raw-text-fallback {
    padding: 0 1;
    color: #d0d7de;
}

.user-msg {
    border-left: thick #6ea8fe;
    background: #141a24;
    color: #e6edf3;
    padding: 0 1;
    margin: 1 0;
}

.notice-line {
    border-left: outer #6ea8fe;
    background: #131720;
    color: #c9d1d9;
    padding: 0 1;
    margin: 0 0 1 0;
}

.notice-warn {
    border-left: outer #d29922;
    color: #e3b341;
}

.notice-err {
    border-left: outer #f85149;
    color: #f85149;
}

/* ThoughtBlock */
ThoughtBlock {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 0 1 0;
}

ThoughtBlock CollapsibleTitle {
    color: #6e7681;
    text-style: italic;
    padding: 0 1;
}

ThoughtBlock .thought-body {
    color: #8b949e;
    text-style: dim italic;
    padding: 0 2;
    max-height: 4;
}

ThoughtBlock.expanded-full .thought-body {
    max-height: 30;
}

/* ActivityGroup & ToolCard */
ActivityGroup {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 0 1 0;
}

ActivityGroup CollapsibleTitle {
    color: #8b949e;
    padding: 0 1;
}

ToolCard {
    border: none;
    border-left: outer #303a4b;
    background: #11151d;
    padding: 0;
    margin: 0 0 1 0;
}

ToolCard.tool-running {
    border-left: outer #6ea8fe;
}

ToolCard.tool-ok {
    border-left: outer #3fb950;
}

ToolCard.tool-err {
    border-left: outer #f85149;
    background: #1d1215;
}

ToolCard CollapsibleTitle {
    color: #c9d1d9;
    padding: 0 1;
}

ToolCard.tool-err CollapsibleTitle {
    color: #f85149;
    text-style: bold;
}

ToolCard .tool-detail {
    padding: 0 2 1 2;
    color: #9aa4b2;
}

ToolCard .diff-summary-row {
    height: auto;
    padding: 0 2;
}

ToolCard .diff-fullscreen-btn {
    height: 1;
    min-width: 12;
    border: none;
    background: #1f2633;
    color: #6ea8fe;
    margin-left: 1;
}

/* Activity bar */
#activity-bar {
    display: none;
    height: 1;
    padding: 0 2;
    background: #111622;
    color: #6ea8fe;
}

#activity-bar.visible {
    display: block;
}

/* Composer Pro */
PromptComposer {
    height: auto;
    background: #0e1116;
    border-top: solid #222936;
}

#composer-popup {
    display: none;
    height: auto;
    max-height: 9;
    margin: 0 2;
    border: solid #2a3344;
    background: #151922;
    color: #c9d1d9;
    scrollbar-size: 1 1;
}

#composer-popup.visible {
    display: block;
}

#composer-popup-hint {
    display: none;
    height: 1;
    margin: 0 2;
    padding: 0 1;
    color: #6e7681;
    background: #131720;
}

#composer-popup-hint.visible {
    display: block;
}

#reverse-search-bar {
    display: none;
    height: 3;
    margin: 0 2;
    background: #151922;
    border: solid #6ea8fe;
    color: #e6edf3;
}

#reverse-search-bar.visible {
    display: block;
}

#attachment-bar {
    display: none;
    height: auto;
    padding: 0 2;
    background: #11151d;
    color: #6ea8fe;
}

#attachment-bar.visible {
    display: block;
}

#input-row {
    height: auto;
    padding: 0 2 1 2;
    align: left bottom;
}

#prompt-input {
    width: 1fr;
    min-height: 3;
    max-height: 10;
    height: 3;
    background: #151922;
    border: solid #2a3344;
    color: #e6edf3;
}

#prompt-input:focus {
    border: solid #6ea8fe;
}

#send-btn {
    min-width: 10;
    height: 3;
    margin-left: 1;
    background: #1f2633;
    color: #e6edf3;
    border: solid #303a4b;
}

#send-btn:hover {
    background: #2a3446;
}

/* Telemetry sidebar */
TelemetryPanel {
    width: 36;
    border-left: solid #262e3d;
    padding: 1 2;
    background: #131720;
    height: 1fr;
    scrollbar-size: 1 1;
    scrollbar-color: #2a3344;
    scrollbar-color-hover: #485263;
    scrollbar-background: #131720;
}

#telemetry-panel.hidden {
    display: none;
}

.panel-section {
    color: #6e7681;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    border-bottom: solid #1f2633;
}

.panel-section-first {
    margin-top: 0;
}

#tel-zone {
    margin-top: 1;
    text-style: bold;
}

#tel-zone-hint {
    color: #8b949e;
    margin-bottom: 1;
}

.zone-green { color: #3fb950; }
.zone-amber { color: #d29922; }
.zone-red { color: #f85149; }

#quota-list {
    height: auto;
    margin-top: 1;
}

#quota-empty, #subagent-tree {
    color: #8b949e;
    margin-top: 1;
}

#tel-glossary-hint {
    color: #6e7681;
    margin-top: 1;
}

MetricGauge {
    height: auto;
    margin-bottom: 1;
}

MetricGauge .gauge-header {
    height: 1;
    width: 1fr;
}

MetricGauge .gauge-label {
    width: 1fr;
    color: #9aa4b2;
}

MetricGauge .gauge-value {
    width: auto;
    color: #e6edf3;
    text-style: bold;
}

MetricGauge ProgressBar {
    width: 1fr;
    height: 1;
    padding: 0;
}

MetricGauge ProgressBar Bar {
    width: 1fr;
}

MetricGauge ProgressBar Bar > .bar--bar,
MetricGauge ProgressBar Bar > .bar--complete {
    color: #3fb950;
    background: #222936;
}

MetricGauge.gauge-warn ProgressBar Bar > .bar--bar,
MetricGauge.gauge-warn ProgressBar Bar > .bar--complete {
    color: #d29922;
}

MetricGauge.gauge-danger ProgressBar Bar > .bar--bar,
MetricGauge.gauge-danger ProgressBar Bar > .bar--complete {
    color: #f85149;
}

MetricGauge.gauge-accent ProgressBar Bar > .bar--bar,
MetricGauge.gauge-accent ProgressBar Bar > .bar--complete {
    color: #6ea8fe;
}

MetricGauge.gauge-muted ProgressBar Bar > .bar--bar,
MetricGauge.gauge-muted ProgressBar Bar > .bar--complete {
    color: #485263;
}

MetricRow {
    height: 1;
    width: 1fr;
}

MetricRow .metric-key {
    width: 1fr;
    color: #8b949e;
}

MetricRow .metric-val {
    width: auto;
    color: #e6edf3;
}

MetricRow.val-warn .metric-val {
    color: #d29922;
    text-style: bold;
}

MetricRow.val-ok .metric-val {
    color: #3fb950;
    text-style: bold;
}

MetricRow.val-danger .metric-val {
    color: #f85149;
    text-style: bold;
}

/* Modals */
PermissionModal, ElicitationModal, HandoffReviewModal, SessionPickerModal, HelpGlossaryModal, DiffPreviewModal, DelegationModal, QuickSelectModal, ContextInspectorModal {
    align: center middle;
    background: rgba(8, 10, 14, 0.80);
}

.modal-dialog {
    width: 84;
    max-width: 94%;
    max-height: 88%;
    height: auto;
    border: solid #303a4b;
    background: #151922;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: #e6edf3;
    margin-bottom: 1;
}

.modal-scroll {
    height: auto;
    max-height: 24;
    padding-right: 1;
    scrollbar-size: 1 1;
}

.modal-buttons {
    margin-top: 1;
    height: auto;
}

.modal-buttons Button {
    margin-right: 1;
}

.risk-high {
    color: #f85149;
    text-style: bold;
}

.risk-med {
    color: #6ea8fe;
    text-style: bold;
}

.risk-low {
    color: #3fb950;
    text-style: bold;
}

#handoff-editor {
    height: 18;
    background: #0e1116;
    border: solid #2a3344;
    margin: 1 0;
}

#delegate-question {
    height: 4;
    background: #0e1116;
    border: solid #2a3344;
    margin: 0 0 1 0;
}

#session-picker-list {
    height: 14;
    border: solid #2a3344;
    background: #0e1116;
    margin: 1 0;
}

#glossary-dialog {
    width: 84;
    max-width: 92%;
    height: 82%;
    border: solid #303a4b;
    background: #151922;
    padding: 1 2;
}

#glossary-scroll {
    height: 1fr;
    padding-right: 1;
}

#glossary-footer {
    height: auto;
    align: right middle;
    margin-top: 1;
}

#diff-fullscreen-dialog {
    width: 96%;
    height: 92%;
    border: solid #6ea8fe;
    background: #0e1116;
    padding: 1 2;
}

#diff-fullscreen-scroll {
    height: 1fr;
}

/* V3.6 WelcomeCard, Copy Code, Search, Queue, Responsive & Themes */
WelcomeCard {
    height: auto;
    border: round #263245;
    background: #121722;
    padding: 1 2;
    margin: 1 0;
}

WelcomeCard .welcome-title {
    color: #6ea8fe;
    text-style: bold;
    margin-bottom: 1;
}

WelcomeCard .welcome-meta {
    color: #c9d1d9;
}

WelcomeCard .welcome-tips {
    color: #8b949e;
    margin-top: 1;
}

AssistantMessage .copy-code-btn {
    height: 1;
    min-width: 12;
    border: none;
    background: #1a2433;
    color: #6ea8fe;
    padding: 0 1;
    margin-right: 1;
}

AssistantMessage .copy-code-btn:hover {
    background: #26354d;
    color: #e6edf3;
}

.search-match-active {
    border-left: thick #f0c674;
    background: #221d12;
}

#transcript-search-bar {
    display: none;
    height: 3;
    padding: 0 2;
    background: #131823;
    border-top: solid #262e3d;
    align: left middle;
}

#transcript-search-bar.visible {
    display: block;
}

#transcript-search-input {
    width: 1fr;
    height: 3;
    background: #151922;
    border: solid #6ea8fe;
    color: #e6edf3;
}

#transcript-search-count {
    width: auto;
    min-width: 10;
    padding: 1 1 0 2;
    color: #8b949e;
}

#queue-bar {
    display: none;
    height: 1;
    padding: 0 2;
    background: #182232;
    color: #79c0ff;
    align: left middle;
}

#queue-bar.visible {
    display: block;
}

#queue-text {
    width: 1fr;
    color: #79c0ff;
}

#queue-clear-btn {
    height: 1;
    min-width: 8;
    border: none;
    background: #26344a;
    color: #e6edf3;
    padding: 0 1;
}

TelemetryPanel.compact {
    width: 30;
    padding: 1 1;
}

/* Theme: Optigravity Daylight (Light) */
Screen.theme-light {
    background: #f6f8fa;
    color: #1f2328;
}

.theme-light Header,
.theme-light Footer {
    background: #eaeef2;
    color: #24292f;
}

.theme-light #session-bar {
    background: #eaeef2;
    color: #1f2328;
}

.theme-light SessionTranscript {
    background: #f6f8fa;
    scrollbar-background: #f6f8fa;
    scrollbar-color: #c8d1da;
}

.theme-light TelemetryPanel {
    background: #ffffff;
    border-left: solid #d0d7de;
    scrollbar-background: #ffffff;
}

.theme-light WelcomeCard {
    background: #ffffff;
    border: round #d0d7de;
}

.theme-light WelcomeCard .welcome-title {
    color: #0969da;
}

.theme-light WelcomeCard .welcome-meta {
    color: #1f2328;
}

.theme-light WelcomeCard .welcome-tips {
    color: #57606a;
}

.theme-light .user-msg {
    background: #ddf4ff;
    color: #1f2328;
    border-left: thick #0969da;
}

.theme-light .notice-line {
    background: #eaeef2;
    color: #24292f;
    border-left: outer #0969da;
}

.theme-light ToolCard {
    background: #ffffff;
    border-left: outer #afb8c1;
}

.theme-light ToolCard CollapsibleTitle {
    color: #1f2328;
}

.theme-light PromptComposer {
    background: #f6f8fa;
    border-top: solid #d0d7de;
}

.theme-light #prompt-input,
.theme-light #composer-popup,
.theme-light #transcript-search-input {
    background: #ffffff;
    color: #1f2328;
    border: solid #afb8c1;
}

.theme-light #prompt-input:focus {
    border: solid #0969da;
}

.theme-light #send-btn {
    background: #0969da;
    color: #ffffff;
    border: solid #0550ae;
}

.theme-light #queue-bar {
    background: #ddf4ff;
    color: #0550ae;
}

.theme-light #queue-text {
    color: #0550ae;
}

.theme-light .panel-section {
    color: #57606a;
    border-bottom: solid #d8dee4;
}

.theme-light MetricGauge .gauge-label,
.theme-light MetricRow .metric-key {
    color: #57606a;
}

.theme-light MetricGauge .gauge-value,
.theme-light MetricRow .metric-val {
    color: #1f2328;
}

/* Theme: Optigravity High-Contrast */
Screen.theme-high-contrast {
    background: #000000;
    color: #ffffff;
}

.theme-high-contrast Header,
.theme-high-contrast Footer,
.theme-high-contrast #session-bar {
    background: #000000;
    color: #ffffff;
}

.theme-high-contrast SessionTranscript,
.theme-high-contrast TelemetryPanel,
.theme-high-contrast PromptComposer {
    background: #000000;
    color: #ffffff;
}

.theme-high-contrast TelemetryPanel {
    border-left: solid #ffffff;
}

.theme-high-contrast WelcomeCard {
    background: #000000;
    border: heavy #00ffff;
}

.theme-high-contrast WelcomeCard .welcome-title {
    color: #00ffff;
}

.theme-high-contrast .user-msg {
    background: #001b33;
    color: #ffffff;
    border-left: thick #00ffff;
}

.theme-high-contrast #prompt-input {
    background: #000000;
    color: #ffffff;
    border: heavy #ffffff;
}

.theme-high-contrast #prompt-input:focus {
    border: heavy #ffff00;
}

.theme-high-contrast #send-btn {
    background: #000000;
    color: #ffff00;
    border: heavy #ffff00;
}

/* V3.7 PlanCard, ShellCard, AssistantMessage meta, QuickSelect & ContextInspector */
AssistantMessage .msg-meta {
    width: auto;
    color: #6e7681;
    padding: 0 2 0 0;
}

PlanCard {
    border: none;
    border-left: thick #58a6ff;
    background: #111824;
    padding: 0;
    margin: 0 0 1 0;
}

PlanCard CollapsibleTitle {
    color: #79c0ff;
    text-style: bold;
    padding: 0 1;
}

PlanCard .plan-body {
    padding: 0 2 1 2;
    color: #c9d1d9;
}

ShellCard {
    border: none;
    border-left: outer #303a4b;
    background: #10141c;
    padding: 0;
    margin: 0 0 1 0;
}

ShellCard.tool-running {
    border-left: outer #6ea8fe;
}

ShellCard.tool-ok {
    border-left: outer #3fb950;
}

ShellCard.tool-err {
    border-left: outer #f85149;
    background: #1d1215;
}

ShellCard CollapsibleTitle {
    color: #d0d7de;
    padding: 0 1;
}

ShellCard .tool-detail {
    padding: 0 2 1 2;
    color: #9aa4b2;
}

ShellCard .shell-attach-btn {
    height: 1;
    min-width: 14;
    border: none;
    background: #1a2433;
    color: #6ea8fe;
    padding: 0 1;
}

ShellCard .shell-attach-btn:hover {
    background: #26354d;
    color: #e6edf3;
}

#quick-select-list {
    height: 12;
    border: solid #2a3344;
    background: #0e1116;
    margin: 1 0;
}

#context-inspector-dialog {
    width: 88;
    max-width: 94%;
    height: 82%;
}

#context-inspector-scroll {
    height: 1fr;
    padding-right: 1;
}

/* Complete Light Theme coverage for Modals, Bars, PlanCard, ShellCard & Buttons */
.theme-light .modal-dialog,
.theme-light #glossary-dialog,
.theme-light #diff-fullscreen-dialog {
    background: #ffffff;
    color: #1f2328;
    border: solid #afb8c1;
}

.theme-light .modal-title {
    color: #1f2328;
}

.theme-light #session-picker-list,
.theme-light #quick-select-list,
.theme-light #handoff-editor,
.theme-light #delegate-question {
    background: #f6f8fa;
    color: #1f2328;
    border: solid #afb8c1;
}

.theme-light #proposal-bar {
    background: #fff8c5;
    border-bottom: solid #d4a72c;
}

.theme-light #proposal-text {
    color: #4d2d00;
}

.theme-light #proposal-apply-btn {
    background: #d4a72c;
    color: #1f2328;
}

.theme-light #activity-bar,
.theme-light #attachment-bar,
.theme-light #transcript-search-bar {
    background: #eaeef2;
    color: #0969da;
}

.theme-light PlanCard {
    background: #ddf4ff;
    border-left: thick #0969da;
}

.theme-light PlanCard CollapsibleTitle {
    color: #0550ae;
}

.theme-light PlanCard .plan-body {
    color: #1f2328;
}

.theme-light ShellCard {
    background: #ffffff;
    border-left: outer #afb8c1;
}

.theme-light ShellCard CollapsibleTitle {
    color: #1f2328;
}

.theme-light ShellCard .tool-detail,
.theme-light ToolCard .tool-detail {
    color: #57606a;
}

.theme-light AssistantMessage .copy-md-btn,
.theme-light AssistantMessage .copy-code-btn,
.theme-light ShellCard .shell-attach-btn {
    background: #eaeef2;
    color: #0969da;
}

.theme-light AssistantMessage .msg-meta {
    color: #57606a;
}

.theme-light ThoughtBlock CollapsibleTitle,
.theme-light ThoughtBlock .thought-body,
.theme-light ActivityGroup CollapsibleTitle {
    color: #57606a;
}

/* Complete High-Contrast Theme coverage for Modals, PlanCard & ShellCard */
.theme-high-contrast .modal-dialog,
.theme-high-contrast #glossary-dialog,
.theme-high-contrast #diff-fullscreen-dialog {
    background: #000000;
    color: #ffffff;
    border: heavy #00ffff;
}

.theme-high-contrast #session-picker-list,
.theme-high-contrast #quick-select-list,
.theme-high-contrast #handoff-editor,
.theme-high-contrast #delegate-question {
    background: #000000;
    color: #ffffff;
    border: solid #ffffff;
}

.theme-high-contrast PlanCard,
.theme-high-contrast ShellCard {
    background: #000000;
    border-left: heavy #00ffff;
}

.theme-high-contrast #proposal-bar {
    background: #221a00;
    border-bottom: heavy #ffff00;
}

.theme-high-contrast #proposal-text {
    color: #ffff00;
}
